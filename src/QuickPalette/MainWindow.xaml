<Window x:Class="QuickPalette.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QuickPalette" Width="760" Height="540" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
 KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">
 <Border Background="{StaticResource WindowBg}" CornerRadius="16"
         BorderBrush="#FF3A3F4B" BorderThickness="1">
  <Grid Margin="18">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="2,0,2,14">
    <TextBlock Text="⌘" FontSize="25" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
    <StackPanel>
     <TextBlock Text="QuickPalette" FontSize="13" Foreground="{StaticResource TextMuted}"/>
     <TextBlock Text="Search apps, commands, settings and the web" FontSize="11" Foreground="{StaticResource TextMuted}"/>
    </StackPanel>
    <Button DockPanel.Dock="Right" Content="Settings" Click="Settings_Click"/>
   </DockPanel>
   <TextBox x:Name="SearchBox" Grid.Row="1" Height="54" FontSize="21"
    Padding="15,10" Background="{StaticResource PanelBg}" Foreground="{StaticResource TextMain}"
    BorderBrush="#FF414754" BorderThickness="1" CaretBrush="White"
    TextChanged="SearchBox_TextChanged" VerticalContentAlignment="Center"
    ToolTip="Try an app name, !g search terms, or a command"/>
   <ListBox x:Name="Results" Grid.Row="2" Margin="0,12,0,8"
    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}"
    SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_MouseDoubleClick"
    ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Border Padding="11,9" Margin="0,2" CornerRadius="8" Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={x:Static BooleanToVisibilityConverter.Instance}}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Icon}" FontSize="19" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1">
         <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
       </Grid>
      </Border>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
   <DockPanel Grid.Row="3" Margin="2,4,2,0">
    <TextBlock Text="↑ ↓ Navigate   ↵ Open   Esc Close" Foreground="{StaticResource TextMuted}" FontSize="11"/>
    <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontSize="11"/>
   </DockPanel>
  </Grid>
 </Border>
</Window>
