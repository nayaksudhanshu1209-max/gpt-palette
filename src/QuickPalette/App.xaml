<Application x:Class="QuickPalette.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="WindowBg" Color="#FF17191F"/>
  <SolidColorBrush x:Key="PanelBg" Color="#FF22252D"/>
  <SolidColorBrush x:Key="Accent" Color="#FF8AB4F8"/>
  <SolidColorBrush x:Key="TextMain" Color="#FFF2F4F8"/>
  <SolidColorBrush x:Key="TextMuted" Color="#FF9BA3B4"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#FF2B303B"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Application.Resources>
</Application>
